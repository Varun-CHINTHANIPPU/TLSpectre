# Apply only to TLS-1.3-only hardened configurations (NOT B1/B2/A3).
# jdk.tls.disabledAlgorithms is replaced, not appended, when loaded as an override.
jdk.tls.disabledAlgorithms=SSLv3, TLSv1, TLSv1.1, TLSv1.2, DTLSv1.0, RC4, DES, 3DES_EDE_CBC, MD5withRSA, DH keySize < 2048, EC keySize < 224, anon, NULL, ECDH
jdk.certpath.disabledAlgorithms=MD2, MD5, SHA1, RSA keySize < 2048, DSA keySize < 2048, EC keySize < 224
